# Environment
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Pooled Neon connection used by the app at runtime (host contains -pooler).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/family_tree?sslmode=require

# Direct Neon connection used only by drizzle-kit (migrate, studio). Do not use the pooler here.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/family_tree?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

BETTER_AUTH_URL=http://localhost:3000

# Optional. When unset, verification and reset emails are printed to the server console.
RESEND_API_KEY=

# Required only when RESEND_API_KEY is set. Example: Family Tree <trees@example.com>
EMAIL_FROM=
